# ==============================================================================
# ShopOps Environment Configuration
# ==============================================================================
NODE_ENV=development
LOG_LEVEL=info

# Service Ports
PORT_FRONTEND=3000
PORT_API_GATEWAY=8000
PORT_AUTH_SERVICE=8001
PORT_CATALOG_SERVICE=8002
PORT_ORDER_SERVICE=8003
PORT_INVENTORY_SERVICE=8004
PORT_PAYMENT_SERVICE=8005
PORT_NOTIFICATION_SERVICE=8006
PORT_AIOPS_AGENT=8090

# Database (PostgreSQL - Logical DB ownership per service)
POSTGRES_USER=shopops
POSTGRES_PASSWORD=shopops_dev_secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL_AUTH=postgresql://shopops:shopops_dev_secret@localhost:5432/shopops_auth?schema=public
DATABASE_URL_CATALOG=postgresql://shopops:shopops_dev_secret@localhost:5432/shopops_catalog?schema=public
DATABASE_URL_ORDER=postgresql://shopops:shopops_dev_secret@localhost:5432/shopops_order?schema=public
DATABASE_URL_INVENTORY=postgresql://shopops:shopops_dev_secret@localhost:5432/shopops_inventory?schema=public
DATABASE_URL_PAYMENT=postgresql://shopops:shopops_dev_secret@localhost:5432/shopops_payment?schema=public

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# RabbitMQ Message Broker
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_for_local_development_only_change_in_prod
JWT_ISSUER=shopops-auth
JWT_EXPIRES_IN=1h

# Observability (OpenTelemetry)
OTEL_SERVICE_NAME=shopops
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
PROMETHEUS_PORT=9090

# Azure Configuration (Used in Cloud Stage)
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_RESOURCE_GROUP=rg-shopops-dev
AZURE_LOCATION=eastus
AZURE_ACR_NAME=acrshopopsdev
AZURE_AKS_CLUSTER_NAME=aks-shopops-dev
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
